<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/layer_card_background"
    android:visibility="visible"
    android:paddingBottom="5dp">
    <RelativeLayout
        android:id="@+id/itemGridHeader"
        android:layout_width="fill_parent"
        android:layout_height="48dp"
        android:clickable="true">

        <TextView
            android:id="@+id/itemGridHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/list_of_items"
            android:layout_alignParentTop="false"
            style="@style/card_header_title"
            android:visibility="visible"
            android:layout_toLeftOf="@+id/itemGridRemoveAllView"
            android:singleLine="true" />

        <LinearLayout
            android:id="@+id/itemGridRemoveAllView"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_alignParentEnd="false"
            android:layout_alignParentRight="false"
            android:visibility="gone"
            android:layout_toLeftOf="@+id/itemGridRemoveItemsView"
            >

            <ImageView
                android:id="@+id/itemGridHeaderSeparator2"
                style="@style/card_header_separator"
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="@color/divider_light"
                android:contentDescription="@null"
                android:visibility="visible" />

            <Button
                android:id="@+id/itemGridHeaderButtonRemoveAll"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/remove_all"
                style="@style/card_header_button"
                android:textStyle="bold"
                android:textColor="#FFFF4444"
                android:visibility="visible"
                android:singleLine="false"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemGridRemoveItemsView"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:visibility="visible"
            android:layout_toLeftOf="@+id/itemGridConfirmItemView">

            <ImageView
                android:id="@+id/itemGridHeaderSeparator1"
                style="@style/card_header_separator"
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="@color/divider_light"
                android:contentDescription="@null" />

            <ToggleButton
                android:id="@+id/itemGridHeaderButtonRemoveItems"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:checked="false"
                android:textOn=""
                android:textOff=""
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:background="@drawable/ic_toggle_remove_selector"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemGridConfirmItemView"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:clickable="true"
            android:visibility="gone"
            android:layout_toLeftOf="@+id/itemGridAddItemView">

            <ImageView
                android:id="@+id/itemGridHeaderSeparator3"
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="@color/divider_light"
                android:contentDescription="@null"
                style="@style/card_header_separator"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/itemGridConfirmItemInnerView"
                android:orientation="horizontal"
                android:layout_width="80dp"
                android:layout_height="fill_parent"
                style="@style/card_header_button"
                android:background="@drawable/button_press_white_lightgray_selector"
                android:visibility="visible">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:id="@+id/imageView"
                    android:background="@drawable/ic_confirm_active"
                    android:layout_gravity="center"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="20" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="@string/add"
                    android:id="@+id/textView"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="80"
                    android:textStyle="bold"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemGridAddItemView"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:visibility="visible"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">

            <ImageView
                android:id="@+id/itemGridAddItemSeparator"
                style="@style/card_header_separator"
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="@color/divider_light"
                android:contentDescription="@null"
                android:visibility="visible" />

            <ToggleButton
                android:id="@+id/itemGridHeaderButtonAddItem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOff=" "
                android:textOn=" "
                android:visibility="visible"
                android:background="@drawable/ic_toggle_add_undo_selector"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

        </LinearLayout>

    </RelativeLayout>

    <ViewStub
        android:id="@+id/expandableItemIVs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        />
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/expandable_layout_4_item_grid"
        android:id="@+id/expandableItemGrid"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginLeft="4dp" />

    <!-- Main Content View -->

</LinearLayout>