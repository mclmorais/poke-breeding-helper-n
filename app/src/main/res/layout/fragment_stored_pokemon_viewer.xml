<!--suppress AndroidUnknownAttribute -->
<view xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view3"
    class="android.support.v7.widget.CardView"
    android:layout_width="250dp"
    android:layout_height="232dp">

    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:fab="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="250dp"
        android:layout_height="232dp"
        tools:context=".StoredPokemonViewerFragment">


        <View
            android:id="@+id/backgroundTop"
            android:layout_width="fill_parent"
            android:layout_height="100dp"
            android:layout_alignBottom="@+id/horizontalSeparator333"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@color/colorPrimary"
            android:visibility="visible" />

        <View
            android:id="@+id/horizontalSeparator1"
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/linearLayout8"
            android:background="@color/background_light_gray" />

        <View
            android:id="@+id/horizontalSeparator333"
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="80dp"
            android:background="@color/colorAccent" />

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignBottom="@+id/imageViewInsideCircle"
            android:layout_alignLeft="@+id/imageViewInsideCircle"
            android:layout_marginBottom="48dp"
            android:layout_marginLeft="48dp"
            android:src="@drawable/circle" />

        <ImageView
            android:id="@+id/imageViewInsideCircle"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="49dp"
            android:src="@drawable/circle" />

        <de.hdodenhof.circleimageview.CircleImageView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/imagePokemonPopupIcon"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="48dp"
            android:src="@drawable/pkmn_big_000"
            app:border_color="@color/colorAccent"
            app:border_width="2dp" />

        <TextView
            android:id="@+id/textPokemonPopupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignTop="@+id/backgroundTop"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:fontFamily="Condensed"
            android:text="@string/label_pokemon_missing"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imagePokemonPopupIcon"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagePokemonPopupHP"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/iv_circle_clear" />

            <ImageView
                android:id="@+id/imagePokemonPopupATK"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/iv_triangle_clear" />

            <ImageView
                android:id="@+id/imagePokemonPopupDEF"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/iv_square_clear" />

            <ImageView
                android:id="@+id/imagePokemonPopupSATK"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/iv_heart_clear" />

            <ImageView
                android:id="@+id/imagePokemonPopupSDEF"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/iv_star_clear" />

            <ImageView
                android:id="@+id/imagePokemonPopupSPD"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/iv_diamond_clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/textPokemonPopupNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignTop="@+id/backgroundTop"
            android:layout_gravity="center"
            android:layout_marginRight="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/placeholder_number_2"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/linearLayout8"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linearLayout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="13dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textPokemonPopupNature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_horizontal"
                    android:text="@string/label_no_nature"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/textView13"
                    style="@style/CapsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:text="@string/label_nature_sans_colon"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/secondary_text"
                    android:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textPokemonPopupAbility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/label_no_ability"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/textView16"
                    style="@style/CapsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/label_ability_sans_colon"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/secondary_text"
                    android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imagePokemonPopupGender"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignBottom="@+id/imageViewInsideCircle"
            android:layout_alignLeft="@+id/imageViewInsideCircle"
            android:layout_alignParentTop="false"
            android:layout_marginBottom="50dp"
            android:layout_marginLeft="50dp"
            android:background="@drawable/symbol_male" />

        <TextView
            android:id="@+id/textPokemonPopupEggGroup1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/backgroundTop"
            android:layout_alignEnd="@+id/backgroundTop"
            android:layout_alignRight="@+id/backgroundTop"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:layout_marginRight="10dp"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/placeholder"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#ffcfcfcf"
            android:textSize="10sp"
            android:textStyle="italic"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/textPokemonPopupEggGroup2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/textPokemonPopupEggGroup1"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginRight="10dp"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/placeholder"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#ffcfcfcf"
            android:textSize="10sp"
            android:textStyle="italic"
            android:visibility="invisible" />

        <view
            android:id="@+id/buttonPokemonPopupEdit"
            class="com.melnykov.fab.FloatingActionButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="27dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/ic_action_edit2"
            fab:fab_colorNormal="@color/colorAccent"
            fab:fab_colorPressed="@color/colorPrimary"
            fab:fab_shadow="false"
            fab:fab_type="mini" />

        <Button
            android:id="@+id/buttonPokemonPopupClose"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/linearLayout8"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/button_press_white_lightgray_selector"
            android:text="@string/label_close"
            android:textAllCaps="true"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="visible" />

    </RelativeLayout>
</view>
