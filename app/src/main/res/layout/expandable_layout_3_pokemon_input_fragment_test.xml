<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="visible"
    android:clickable="true"
    android:background="@drawable/layer_card_background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:id="@+id/LinearLayoutEgg"
        android:background="#0cf9fffb"
        android:layout_marginTop="8dp">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="10"
            android:rowCount="11"
            android:id="@+id/gridviewPokemonInput"
            android:visibility="visible"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_hp"
                android:id="@+id/labelInputHP"
                android:layout_row="0"
                android:layout_column="1"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textIsSelectable="false"
                android:textAlignment="gravity"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_atk"
                android:id="@+id/labelInputATK"
                android:layout_row="0"
                android:layout_column="2"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textIsSelectable="false"
                android:textAlignment="gravity"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="-10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_def"
                android:id="@+id/labelInputDEF"
                android:layout_row="0"
                android:layout_column="3"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textIsSelectable="false"
                android:textAlignment="gravity"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="-10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_satk"
                android:id="@+id/labelInputSATK"
                android:layout_row="0"
                android:layout_column="4"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textIsSelectable="false"
                android:textAlignment="gravity"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="-10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_sdef"
                android:id="@+id/labelInputSDEF"
                android:layout_row="0"
                android:layout_column="5"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textIsSelectable="false"
                android:textAlignment="gravity"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="-10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_spd"
                android:id="@+id/labelInputSPD"
                android:layout_row="0"
                android:layout_column="6"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textIsSelectable="false"
                android:textAlignment="gravity"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="-10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_gender"
                android:id="@+id/labelInputGender"
                android:layout_row="0"
                android:layout_column="0"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textIsSelectable="false"
                android:textAlignment="gravity"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="0dp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                style="@style/AppTheme"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/checkBoxInputHP"
                android:checked="false"
                android:button="@android:color/transparent"
                android:maxHeight="30dp"
                android:maxWidth="20dp"
                android:background="@drawable/ic_iv_circle_selector"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="5dp"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="10dp" />

            <CheckBox
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/checkBoxInputATK"
                android:checked="false"
                android:background="@drawable/ic_iv_triangle_selector"
                android:button="@android:color/transparent"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="5dp"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_gravity="center_horizontal" />

            <CheckBox
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/checkBoxInputSDEF"
                android:checked="false"
                android:button="@android:color/transparent"
                android:background="@drawable/ic_iv_star_selector"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="5dp"
                android:layout_row="1"
                android:layout_column="5"
                android:layout_gravity="center_horizontal" />

            <CheckBox
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/checkBoxInputSPD"
                android:checked="false"
                android:background="@drawable/ic_iv_diamond_selector"
                android:button="@android:color/transparent"
                android:layout_marginBottom="5dp"
                android:layout_row="1"
                android:layout_column="6"
                android:layout_marginRight="10dp"
                android:layout_gravity="center_horizontal" />

            <CheckBox
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/checkBoxInputDEF"
                android:checked="false"
                android:background="@drawable/ic_iv_square_selector"
                android:button="@android:color/transparent"
                android:layout_row="1"
                android:layout_column="3"
                android:layout_marginRight="10dp"
                android:layout_gravity="center_horizontal" />

            <CheckBox
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/checkBoxInputSATK"
                android:checked="false"
                android:background="@drawable/ic_iv_heart_selector"
                android:button="@android:color/transparent"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="5dp"
                android:layout_row="1"
                android:layout_column="4"
                android:layout_gravity="center_horizontal" />

            <ToggleButton
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/toggleButtonInputGender"
                android:background="@drawable/ic_toggle_gender_selector"
                android:textOff=" "
                android:textOn=""
                android:layout_row="1"
                android:layout_column="0"
                android:layout_gravity="center_horizontal"
                android:checked="true" />

        </GridLayout>

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/imageViewSelectedIcon"
                android:background="@drawable/ic_egg_outline"
                android:layout_weight="0"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_marginLeft="8dp" />

            <TextView
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="No pokemon selected"
                android:id="@+id/textViewSelectedName"
                android:textStyle="bold"
                android:textSize="15sp"
                android:visibility="visible"
                android:gravity="center_vertical"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/imageViewSelectedIcon"
                android:layout_toEndOf="@+id/imageViewSelectedIcon"
                android:layout_marginLeft="8dp" />

            <Button
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:text="Select"
                android:id="@+id/buttonSelectPokemon"
                style="@style/MyRaisedButton"
                android:layout_gravity="right"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_marginRight="12dp"
                android:textColor="@color/primary" />
        </RelativeLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

        </LinearLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:background="@color/background_light_gray"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:id="@+id/horizontalSeparator1"
            android:layout_marginTop="6dp" />

        <Button
            android:textSize="16sp"
            android:textAllCaps="true"
            android:textColor="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/button_confirm"
            android:id="@+id/confirmIVsButton"
            android:layout_gravity="center_horizontal"
            android:visibility="visible"
            android:background="@drawable/button_press_white_lightgray_selector"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>