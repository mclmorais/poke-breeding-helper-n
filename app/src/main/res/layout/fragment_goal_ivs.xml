<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relativeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin">


    <TextView
        android:id="@+id/info_text"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="@string/label_goal_ivs"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:visibility="visible"
        android:textStyle="bold"
        android:layout_alignParentTop="true"
        android:layout_alignLeft="@+id/goalCardView"
        android:layout_alignStart="@+id/goalCardView" />

    <android.support.v7.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:id="@+id/goalCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        card_view:cardCornerRadius="4dp"
        android:layout_below="@+id/info_text"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="false"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:paddingBottom="4dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp">

            <FrameLayout
                android:id="@+id/frameLayoutPokemonSelectorButton"
                style="@style/MyRaisedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true">

            </FrameLayout>

            <TextView
                android:id="@+id/textViewPokemonName"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:layout_alignParentTop="false"
                android:layout_toRightOf="@+id/frameLayoutPokemonSelectorButton"
                android:singleLine="true"
                android:text="@string/label_select_pokemon"
                android:textAllCaps="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="24dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_above="@+id/LayoutIVs"
                android:gravity="center_vertical"
                android:layout_marginLeft="8dp" />

            <Spinner
                android:id="@+id/spinnerGoalIVsNatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="160dp"
                android:layout_below="@+id/textView2"
                android:layout_toLeftOf="@+id/checkBoxGoalIVsActivateNatures"
                android:layout_toStartOf="@+id/checkBoxGoalIVsActivateNatures" />

            <LinearLayout
                android:id="@+id/LayoutIVs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/frameLayoutPokemonSelectorButton"
                android:layout_alignLeft="@+id/spinnerGoalIVsNatures"
                android:layout_alignStart="@+id/spinnerGoalIVsNatures"
                android:layout_alignRight="@+id/checkBoxGoalIVsActivateNatures"
                android:layout_alignEnd="@+id/checkBoxGoalIVsActivateNatures"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <CheckBox
                    android:id="@+id/checkBoxGoalHP"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:button="@drawable/ic_iv_circle_selector"
                    android:checked="false" />

                <CheckBox
                    android:id="@+id/checkBoxGoalATK"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_triangle_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalDEF"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_square_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSATK"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_heart_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSDEF"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_star_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSPD"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_diamond_selector" />
            </LinearLayout>

            <Switch
                android:id="@+id/checkBoxGoalIVsActivateNatures"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignBottom="@+id/spinnerGoalIVsNatures"
                android:layout_alignTop="@+id/spinnerGoalIVsNatures"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_nature_sans_colon"
                android:textAllCaps="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="12sp"
                android:layout_below="@+id/LayoutIVs"
                android:layout_alignLeft="@+id/spinnerGoalIVsNatures"
                android:layout_alignStart="@+id/spinnerGoalIVsNatures" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_ability_sans_colon"
                android:textAllCaps="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="12sp"
                android:layout_below="@+id/spinnerGoalIVsNatures"
                android:layout_alignLeft="@+id/spinnerGoalIVsNatures"
                android:layout_alignStart="@+id/spinnerGoalIVsNatures"
                android:layout_marginTop="4dp" />

            <Spinner
                android:id="@+id/spinnerGoalIVsAbilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_below="@+id/textView8"
                android:layout_alignLeft="@+id/textView8"
                android:layout_alignStart="@+id/textView8"
                android:layout_toLeftOf="@+id/checkBoxGoalIVsActivateAbilities"
                android:layout_toStartOf="@+id/checkBoxGoalIVsActivateAbilities" />

            <Switch
                android:id="@+id/checkBoxGoalIVsActivateAbilities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/spinnerGoalIVsAbilities"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@+id/spinnerGoalIVsAbilities" />

            <ImageView
                android:id="@+id/imageViewSelectedPokemonIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/pkmn_big_000"
                android:layout_alignTop="@+id/textViewPokemonName"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true" />

        </RelativeLayout>

    </android.support.v7.widget.CardView>


</RelativeLayout>