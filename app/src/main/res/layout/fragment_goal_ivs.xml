<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:background="@color/primary"
    android:id="@+id/relativeLayout">


    <android.support.v7.widget.CardView
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:id="@+id/goalCardView"
        android:layout_width="wrap_content"
        android:layout_height="76dp"
        card_view:cardCornerRadius="4dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="false"
        android:layout_alignParentStart="false"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_centerHorizontal="true">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingRight="16dp"
            android:paddingLeft="16dp"
            android:paddingBottom="4dp"
            android:paddingTop="4dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/linearLayout"
                android:layout_alignParentBottom="true"
                android:layout_toRightOf="@+id/frameLayoutPokemonSelectorButton"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="4dp">

                <CheckBox
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:id="@+id/checkBoxGoalHP"
                    android:button="@drawable/ic_iv_circle_selector"
                    android:checked="false" />

                <CheckBox
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/checkBoxGoalATK"
                    android:button="@drawable/ic_iv_triangle_selector" />

                <CheckBox
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/checkBoxGoalDEF"
                    android:button="@drawable/ic_iv_square_selector" />

                <CheckBox
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/checkBoxGoalSATK"
                    android:button="@drawable/ic_iv_heart_selector" />

                <CheckBox
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/checkBoxGoalSDEF"
                    android:button="@drawable/ic_iv_star_selector" />

                <CheckBox
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/checkBoxGoalSPD"
                    android:button="@drawable/ic_iv_diamond_selector" />
            </LinearLayout>

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/label_select_pokemon"
                android:id="@+id/textViewPokemonName"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_above="@+id/linearLayout"
                android:textAllCaps="true"
                android:layout_toRightOf="@+id/frameLayoutPokemonSelectorButton"
                android:layout_marginLeft="12dp" />

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                style="@style/MyRaisedButton"
                android:id="@+id/frameLayoutPokemonSelectorButton"
                android:layout_centerVertical="true">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:id="@+id/imageViewSelectedPokemonIcon"
                    android:background="@drawable/pkmn_big_000"
                    android:layout_gravity="center" />
            </FrameLayout>

        </RelativeLayout>

    </android.support.v7.widget.CardView>

    <TextView
        android:id="@+id/info_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_goal_ivs"
        android:layout_above="@+id/goalCardView"
        android:layout_alignLeft="@+id/goalCardView"
        android:textStyle="bold"
        android:textColor="@android:color/white" />


</RelativeLayout>