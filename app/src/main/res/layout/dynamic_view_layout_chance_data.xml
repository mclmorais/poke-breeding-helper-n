<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">
<RelativeLayout
    android:orientation="vertical" android:layout_width="0dp"
    android:layout_height="72dp"
    android:layout_weight="70">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:id="@+id/frameLayout"
        android:background="@drawable/ic_egg_outline"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_marginLeft="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="@string/placeholder_number_2"
            android:id="@+id/textDynamicChanceNumber"
            android:layout_gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:id="@+id/imageDynamicChanceShinyIndicator"
            android:layout_gravity="right|bottom"
            android:background="@drawable/ic_star"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:id="@+id/linearLayout2"
        android:gravity="center|center_vertical"
        android:layout_alignParentTop="false"
        android:layout_toRightOf="@+id/frameLayout"
        android:layout_alignParentRight="false"
        android:layout_alignParentEnd="false">

        <TextView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="@string/placeholder_number_2"
            android:id="@+id/textDynamicChanceFirstNumber"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:layout_marginRight="4dp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:id="@+id/imageDynamicChanceFirstGender"
            android:background="@drawable/symbol_male"
            android:layout_marginRight="4dp" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:id="@+id/imageDynamicChanceFirstIcon"
                android:background="@drawable/pkmn_051"
                android:layout_gravity="center" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:id="@+id/imageDynamicChanceFirstItem"
                android:layout_gravity="right|bottom"
                android:focusableInTouchMode="true" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="fill_parent">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|center_horizontal"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceFirstHP"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceFirstATK"
                    android:background="@drawable/iv_triangle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceFirstDEF"
                    android:background="@drawable/iv_square_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceFirstSATK"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceFirstSDEF"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceFirstSPD"
                    android:background="@drawable/iv_circle_clear" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="ADAMANT"
                android:id="@+id/textDynamicChanceFirstNature"
                android:textSize="11sp"
                android:textColor="@color/secondary_text"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="4dp" />
        </FrameLayout>

    </LinearLayout>

    <View android:layout_width="128dp"
        android:layout_height="1dp"
        android:background="@color/background_light_gray"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="8dp"
        android:id="@+id/view"
        android:layout_below="@+id/linearLayout2"
        android:layout_marginTop="-2dp"
        android:layout_toRightOf="@+id/frameLayout"
        android:visibility="invisible" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center|center_vertical"
        android:layout_alignParentBottom="false"
        android:layout_toRightOf="@+id/frameLayout"
        android:id="@+id/linearLayout3"
        android:layout_alignParentRight="false"
        android:layout_alignParentEnd="false"
        android:layout_below="@+id/linearLayout2">

        <TextView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="@string/placeholder_number_2"
            android:id="@+id/textDynamicChanceSecondNumber"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:layout_marginRight="4dp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:id="@+id/imageDynamicChanceSecondGender"
            android:layout_marginRight="4dp"
            android:background="@drawable/symbol_male" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:id="@+id/imageDynamicChanceSecondIcon"
                android:background="@drawable/pkmn_687"
                android:layout_gravity="center" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:id="@+id/imageDynamicChanceSecondItem"
                android:layout_gravity="right|bottom"
                android:focusableInTouchMode="false" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="fill_parent">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|center_horizontal"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceSecondHP"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceSecondATK"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceSecondDEF"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceSecondSATK"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceSecondSDEF"
                    android:background="@drawable/iv_circle_clear" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:id="@+id/imageDynamicChanceSecondSPD"
                    android:background="@drawable/iv_circle_clear" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="ADAMANT"
                android:id="@+id/textDynamicChanceSecondNature"
                android:textSize="11sp"
                android:textColor="@color/secondary_text"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="4dp" />
        </FrameLayout>

    </LinearLayout>

    <View android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/background_light_gray"
        android:id="@+id/view2"
        android:layout_alignParentTop="false"
        android:layout_alignParentRight="true" />

</RelativeLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="fill_parent"
        android:layout_weight="30"
        android:gravity="center">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:id="@+id/imageView23"
            android:background="@drawable/ic_symbol_luck" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="0,26%"
                android:id="@+id/textDynamicChancePercentage"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="~192 eggs"
                android:id="@+id/textDynamicChanceEggs"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>