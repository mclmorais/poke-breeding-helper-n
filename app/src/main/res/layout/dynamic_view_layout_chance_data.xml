<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <RelativeLayout
        android:id="@+id/asd"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_alignParentTop="false"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="false"
            android:layout_alignParentRight="false"
            android:layout_alignParentTop="false"
            android:layout_toRightOf="@+id/frameLayout"
            android:gravity="center|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textDynamicChanceFirstNumber"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="4dp"
                android:gravity="center"
                android:text="@string/placeholder_number_2"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/colorWhitebgSecondaryText"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageDynamicChanceFirstGender"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/symbol_male" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="4dp">

                <ImageView
                    android:id="@+id/imageDynamicChanceFirstIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pkmn_717" />

                <ImageView
                    android:id="@+id/imageDynamicChanceFirstItem"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="right|bottom"
                    android:focusableInTouchMode="true" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent">

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical|center_horizontal"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageDynamicChanceFirstHP"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceFirstATK"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_triangle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceFirstDEF"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_square_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceFirstSATK"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceFirstSDEF"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceFirstSPD"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textDynamicChanceFirstNature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="sans-serif-condensed"
                    android:singleLine="true"
                    android:text="@string/placeholder"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:textSize="11sp"
                    tools:ignore="SmallSp" />
            </FrameLayout>

        </LinearLayout>

        <View
            android:id="@+id/view"
            android:layout_width="100dp"
            android:layout_height="1dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginTop="-2dp"
            android:background="@color/background_light_gray"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentBottom="false"
            android:layout_below="@+id/linearLayout2"
            android:layout_toRightOf="@+id/frameLayout"
            android:gravity="center|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textDynamicChanceSecondNumber"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="4dp"
                android:gravity="center"
                android:text="@string/placeholder_number_2"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/colorWhitebgSecondaryText"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageDynamicChanceSecondGender"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/symbol_male" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp">

                <ImageView
                    android:id="@+id/imageDynamicChanceSecondIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pkmn_718" />

                <ImageView
                    android:id="@+id/imageDynamicChanceSecondItem"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="right|bottom"
                    android:focusableInTouchMode="false" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical|center_horizontal"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageDynamicChanceSecondHP"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceSecondATK"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceSecondDEF"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceSecondSATK"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceSecondSDEF"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />

                    <ImageView
                        android:id="@+id/imageDynamicChanceSecondSPD"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/iv_circle_clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textDynamicChanceSecondNature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="sans-serif-condensed"
                    android:singleLine="true"
                    android:text="@string/placeholder"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:textSize="11sp"
                    android:visibility="visible"
                    tools:ignore="SmallSp" />
            </FrameLayout>

        </LinearLayout>

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/dsa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/asd"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginRight="4dp"
        android:layout_toEndOf="@+id/asd"
        android:layout_toRightOf="@+id/asd"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView23"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_new_luck_tinted"
            android:tint="@color/colorPrimary"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">
            <TextView
                android:id="@+id/textDynamicChanceEggs"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="@string/placeholder_eggs"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/colorWhitebgSecondaryText"
                android:textSize="12sp" />

            <ImageView
                android:layout_marginLeft="2dp"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:src="@drawable/ic_small_egg"/>

        </LinearLayout>

        <TextView
            android:id="@+id/textDynamicChancePercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_percentage"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/colorWhitebgSecondaryText"
            android:textSize="12sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/asd"
        android:layout_toStartOf="@+id/asd"
        android:layout_alignBottom="@+id/asd"
        android:layout_alignParentTop="true"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/ic_egg_outline">

            <TextView
                android:id="@+id/textDynamicChanceNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/placeholder_number_2"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/colorWhitebgSecondaryText"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageDynamicChanceShinyIndicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="right|bottom"
                android:background="@drawable/ic_star"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>


</RelativeLayout>