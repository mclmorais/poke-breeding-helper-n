<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:visibility="visible"
    android:animateLayoutChanges="true">

    <View
        android:layout_width="fill_parent"
        android:layout_height="1dp"
        android:background="@color/background_light_gray"
        android:layout_marginRight="2dp"
        android:layout_marginLeft="2dp"
        android:layout_marginBottom="4dp"
        android:id="@+id/horizontalSeparator2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/better_match_found"
        android:fontFamily="sans-serif-condensed"
        android:id="@+id/textViewBetterMatchFound"
        android:textIsSelectable="false"
        android:textSize="18sp"
        android:textColor="#ff2fad54"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/horizontalSeparator2" />

    <View
        android:layout_width="fill_parent"
        android:layout_height="1dp"
        android:background="@color/background_light_gray"
        android:layout_marginRight="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/textViewBetterMatchFound"
        android:id="@+id/horizontalSeparator1" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linearLayoutSwitch"
        android:gravity="center_horizontal"
        android:layout_below="@+id/horizontalSeparator1"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="50dp"
            android:layout_height="70dp"
            android:id="@+id/textViewBetterMatchInfo"

            android:textSize="14sp"
            android:text="@string/label_switch"
            android:gravity="center|clip_horizontal|right"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_marginLeft="16dp"
            android:layout_weight="1" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="84dp"
            android:gravity="center_vertical|center_horizontal"
            android:layout_gravity="center_vertical"
            android:layout_weight="2">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:id="@+id/layoutMaleSwitchInfo">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:id="@+id/imageMaleSwitchIcon"
                    android:background="@drawable/symbol_male"
                    android:layout_gravity="center_vertical" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="18dp"
                    android:id="@+id/imageSwitchArrow"
                    android:background="@drawable/ic_arrow_thin_right"
                    android:layout_gravity="center_vertical" />

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/ic_egg_outline"
                    android:id="@+id/frameNewSwitchMaleIcon"
                    android:layout_gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@string/placeholder_number"
                        android:id="@+id/textNewSwitchMaleIcon"
                        android:layout_gravity="center"
                        android:textSize="12sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:id="@+id/layoutFemaleSwitchInfo"
                android:visibility="visible">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:id="@+id/imageFemaleSwitchIcon"
                    android:background="@drawable/symbol_female"
                    android:layout_gravity="center_vertical" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="18dp"
                    android:id="@+id/imageSwitchArrow2"
                    android:background="@drawable/ic_arrow_thin_right"
                    android:layout_gravity="center_vertical" />

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/ic_egg_outline"
                    android:id="@+id/frameNewSwitchFemaleIcon"
                    android:layout_gravity="center_vertical" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@string/placeholder_number"
                        android:id="@+id/textNewSwitchFemaleIcon"
                        android:layout_gravity="center"
                        android:textSize="12sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_horizontal"
                android:id="@+id/layoutLuckSwitchInfo"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:id="@+id/imageView3"
                    android:background="@drawable/ic_symbol_luck"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="@string/placeholder_percentage_total_and_increase"
                    android:id="@+id/textLuckSwitchInfo"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:text="@string/button_switch"
            android:id="@+id/buttonSwitchEggs"
            android:textStyle="bold"
            android:layout_marginRight="16dp"
            style="@style/MyRaisedButton" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/hiddenEndView"
        android:layout_below="@+id/linearLayoutSwitch" />

</RelativeLayout>