<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin">

    <TextView
        android:id="@+id/info_text"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="@string/label_goal_ivs"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:visibility="visible"
        android:textStyle="bold"
        android:layout_alignParentTop="true"
        android:layout_alignLeft="@+id/goalCardView"
        android:layout_alignStart="@+id/goalCardView" />

    <android.support.v7.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:id="@+id/goalCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        card_view:cardCornerRadius="4dp"
        android:layout_below="@+id/info_text"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="false"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:paddingBottom="4dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:id="@+id/glaucio"
                android:gravity="center_vertical"
                android:layout_alignParentRight="true">

                <com.melnykov.fab.FloatingActionButton
                    android:id="@+id/frameLayoutPokemonSelectorButton"
                    fab:fab_colorNormal="@color/colorPrimary"
                    fab:fab_colorPressed="@color/colorAccent"
                    fab:fab_type="mini"
                    fab:fab_shadow="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_edit2">

                </com.melnykov.fab.FloatingActionButton>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutIVs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:layout_below="@+id/LayoutLabels">

                <CheckBox
                    android:id="@+id/checkBoxGoalHP"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:button="@drawable/ic_iv_circle_selector"
                    android:checked="false"
                    android:layout_marginRight="4dp" />

                <CheckBox
                    android:id="@+id/checkBoxGoalATK"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_triangle_selector"
                    android:layout_marginRight="4dp" />

                <CheckBox
                    android:id="@+id/checkBoxGoalDEF"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_square_selector"
                    android:layout_marginRight="4dp" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSATK"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_heart_selector"
                    android:layout_marginRight="4dp" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSDEF"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_star_selector"
                    android:layout_marginRight="4dp" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSPD"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:button="@drawable/ic_iv_diamond_selector"
                    android:layout_marginRight="4dp" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerGoalIVsNatures"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="fill"
                android:minWidth="160dp"
                android:dropDownWidth="200dp"
                android:layout_below="@+id/textView2"
                android:layout_toLeftOf="@+id/checkBoxGoalIVsActivateNatures"
                android:layout_toStartOf="@+id/checkBoxGoalIVsActivateNatures"/>

            <Spinner
                android:id="@+id/spinnerGoalIVsAbilities"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:dropDownWidth="200dp"
                android:layout_below="@+id/textView8"
                android:layout_alignLeft="@+id/textView8"
                android:layout_alignStart="@+id/textView8"
                android:layout_toLeftOf="@+id/checkBoxGoalIVsActivateAbilities"
                android:layout_toStartOf="@+id/checkBoxGoalIVsActivateAbilities"/>

            <customviews.AutoResizeTextView
                android:id="@+id/textViewPokemonName"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="24sp"
                android:layout_alignParentTop="true"
                android:layout_toRightOf="@+id/imageViewSelectedPokemonIcon"
                android:layout_marginLeft="4dp"
                android:layout_toStartOf="@+id/glaucio"
                android:layout_toLeftOf="@+id/glaucio"
                android:gravity="center"
                android:text="@string/label_select_pokemon"
                android:layout_marginRight="4dp" />
            <ImageView
                android:id="@+id/imageViewInsideCircle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/circle_primary"
                android:layout_alignTop="@+id/imageViewSelectedPokemonIcon"
                android:layout_alignBottom="@+id/imageViewSelectedPokemonIcon"
                android:layout_alignLeft="@+id/imageViewSelectedPokemonIcon"
                android:visibility="visible" />

            <de.hdodenhof.circleimageview.CircleImageView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/imageViewSelectedPokemonIcon"
                android:layout_width="64dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/pkmn_big_000"
                app:border_color="@color/colorPrimaryDark"
                app:border_width="2dp"
                android:layout_alignTop="@+id/textViewPokemonName"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_marginTop="-16dp" />

            <android.support.v7.widget.SwitchCompat
                android:id="@+id/checkBoxGoalIVsActivateNatures"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignBottom="@+id/spinnerGoalIVsNatures"
                android:layout_alignTop="@+id/spinnerGoalIVsNatures"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_nature_sans_colon"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:layout_below="@+id/LayoutIVs"
                android:layout_alignLeft="@+id/spinnerGoalIVsNatures"
                android:layout_alignStart="@+id/spinnerGoalIVsNatures"
                android:textColor="@color/colorWhiteBgDisabledHint" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_ability_sans_colon"
                android:textAllCaps="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="12sp"
                android:layout_below="@+id/spinnerGoalIVsNatures"
                android:layout_alignLeft="@+id/spinnerGoalIVsNatures"
                android:layout_alignStart="@+id/spinnerGoalIVsNatures"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorWhiteBgDisabledHint" />

            <android.support.v7.widget.SwitchCompat
                android:id="@+id/checkBoxGoalIVsActivateAbilities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/spinnerGoalIVsAbilities"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@+id/spinnerGoalIVsAbilities" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/glaucio"
                android:id="@+id/LayoutLabels"
                android:gravity="center_horizontal"
                android:layout_marginBottom="-2dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_hp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textIsSelectable="false"
                    android:textSize="12sp"
                    android:layout_marginRight="4dp"
                    android:gravity="center_horizontal"
                    android:fontFamily="sans-serif-light"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/label_atk"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textIsSelectable="false"
                    android:textSize="12sp"
                    android:layout_marginRight="4dp"
                    android:gravity="center_horizontal"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/label_def"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textIsSelectable="false"
                    android:textSize="12sp"
                    android:layout_marginRight="4dp"
                    android:gravity="center_horizontal"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/label_satk"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textIsSelectable="false"
                    android:textSize="12sp"
                    android:layout_marginRight="4dp"
                    android:gravity="center_horizontal"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/textView22"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/label_sdef"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textIsSelectable="false"
                    android:textSize="12sp"
                    android:layout_marginRight="4dp"
                    android:gravity="center_horizontal"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/textView23"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/label_spd"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textIsSelectable="false"
                    android:textSize="12sp"
                    android:layout_marginRight="4dp"
                    android:gravity="center_horizontal"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:singleLine="true" />

            </LinearLayout>

        </RelativeLayout>

    </android.support.v7.widget.CardView>


</RelativeLayout>