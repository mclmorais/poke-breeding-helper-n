<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin">

    <TextView
        android:id="@+id/goalPokemonLabel"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_alignLeft="@+id/goalCard"
        android:layout_alignParentTop="true"
        android:layout_alignStart="@+id/goalCard"
        android:text="@string/label_goal_ivs"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="visible" />

    <androidx.cardview.widget.CardView
        android:id="@+id/goalCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/goalPokemonLabel"
        android:layout_alignParentEnd="false"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:cardCornerRadius="4dp">

        <RelativeLayout
            android:id="@+id/goalCardLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/glaucio"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_edit2"
                    app:backgroundTint="@color/colorPrimary"
                    app:elevation="0dp"
                    app:fabSize="mini"
                    app:rippleColor="@color/colorAccent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutIVs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/LayoutLabels"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkBoxGoalHP"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginRight="4dp"
                    android:button="@drawable/ic_iv_circle_selector"
                    android:checked="false" />

                <CheckBox
                    android:id="@+id/checkBoxGoalATK"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:button="@drawable/ic_iv_triangle_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalDEF"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:button="@drawable/ic_iv_square_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSATK"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:button="@drawable/ic_iv_heart_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSDEF"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:button="@drawable/ic_iv_star_selector" />

                <CheckBox
                    android:id="@+id/checkBoxGoalSPD"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:button="@drawable/ic_iv_diamond_selector" />
            </LinearLayout>


            <TextView
                android:id="@+id/textViewPokemonName"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_toLeftOf="@+id/glaucio"
                android:layout_toStartOf="@+id/glaucio"
                android:layout_toRightOf="@+id/imageViewSelectedPokemonIcon"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/label_select_pokemon"
                android:textAllCaps="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="24sp" />

            <ImageView
                android:id="@+id/imageViewInsideCircle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_alignLeft="@+id/imageViewSelectedPokemonIcon"
                android:layout_alignTop="@+id/imageViewSelectedPokemonIcon"
                android:layout_alignBottom="@+id/imageViewSelectedPokemonIcon"
                android:src="@drawable/circle_primary"
                android:visibility="visible" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imageViewSelectedPokemonIcon"
                android:layout_width="64dp"
                android:layout_height="72dp"
                android:layout_alignTop="@+id/textViewPokemonName"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_gravity="center"
                android:layout_marginTop="-4dp"
                android:src="@drawable/pkmn_big_003"
                app:civ_border_color="@color/colorPrimaryDark"
                app:civ_border_width="2dp" />


            <LinearLayout
                android:id="@+id/LayoutLabels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/glaucio"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="-2dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:text="@string/label_hp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textIsSelectable="false"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginRight="4dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:text="@string/label_atk"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:textIsSelectable="false"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginRight="4dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:text="@string/label_def"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:textIsSelectable="false"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginRight="4dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:text="@string/label_satk"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:textIsSelectable="false"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textView22"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginRight="4dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:text="@string/label_sdef"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:textIsSelectable="false"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textView23"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginRight="4dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:text="@string/label_spd"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorWhitebgSecondaryText"
                    android:textIsSelectable="false"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutModifiers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layoutIVs"
                android:clipChildren="false"
                android:orientation="vertical">

                <include
                    android:id="@+id/includeNature"
                    layout="@layout/include_nature_picker"
                    android:visibility="gone" />

                <include
                    android:id="@+id/includeAbility"
                    layout="@layout/include_ability_picker"
                    android:visibility="gone" />

                <include
                    android:id="@+id/includeEggMove1"
                    layout="@layout/include_eggmove_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <include
                    android:id="@+id/includeEggMove2"
                    layout="@layout/include_eggmove_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <include
                    android:id="@+id/includeEggMove3"
                    layout="@layout/include_eggmove_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <include
                    android:id="@+id/includeEggMove4"
                    layout="@layout/include_eggmove_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layoutModifiers"
                android:gravity="center_vertical"
                android:paddingLeft="-16dp"
                android:paddingRight="-16dp"
                android:weightSum="3">

                <Button
                    android:id="@+id/buttonAddAbility"
                    style="@style/Base.Widget.AppCompat.Button.Borderless.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+Ability"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonAddNature"
                    style="@style/Base.Widget.AppCompat.Button.Borderless.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+Nature"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonAddEggMove"
                    style="@style/Base.Widget.AppCompat.Button.Borderless.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+Egg Move"
                    android:textSize="13sp" />

            </LinearLayout>


        </RelativeLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>